{
  "name": "@parly/sdk",
  "version": "16.9.9",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lz-options": {
      "types": "./dist/lz-options.d.ts",
      "default": "./dist/lz-options.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "sync:proof-assets": "node ./scripts/sync-proof-assets.mjs",
    "test:lz-options": "pnpm run build && node ./scripts/verify-lz-options.mjs",
    "test:phase3-legacy-gates": "node --test scripts/phase3-legacy-gates.test.mjs",
    "pack:dry-run": "pnpm publish --dry-run --no-git-checks"
  },
  "dependencies": {
    "@layerzerolabs/lz-v2-utilities": "3.0.167",
    "circomlibjs": "0.1.7",
    "fixed-merkle-tree": "0.7.3",
    "libsodium-wrappers-sumo": "^0.7.13",
    "snarkjs": "0.7.4",
    "viem": "2.43.5"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {},
  "optionalDependencies": {}
}
