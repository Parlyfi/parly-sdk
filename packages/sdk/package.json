{
  "name": "@parly/sdk",
  "version": "16.9.10",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./current": {
      "types": "./dist/current.d.ts",
      "default": "./dist/current.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lz-options": {
      "types": "./dist/lz-options.d.ts",
      "default": "./dist/lz-options.js"
    },
    "./coin-selection": {
      "types": "./dist/coin-selection.d.ts",
      "default": "./dist/coin-selection.js"
    },
    "./payout-v7": {
      "types": "./dist/payout-v7.d.ts",
      "default": "./dist/payout-v7.js"
    },
    "./payout-v6": {
      "types": "./dist/payout-v6.d.ts",
      "default": "./dist/payout-v6.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/flatten-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:security": "node --test scripts/launch-context-redaction.test.mjs",
    "test:current": "pnpm run build && node --test scripts/current-v4.test.mjs scripts/current-client.test.mjs scripts/current-transport.test.mjs",
    "sync:proof-assets": "node ./scripts/sync-proof-assets.mjs",
    "test:lz-options": "pnpm run build && node ./scripts/verify-lz-options.mjs",
    "test:phase3-legacy-gates": "pnpm --filter @parly/shared-types run build && pnpm run build && node --test scripts/phase3-legacy-gates.test.mjs scripts/phase3-payout-v5.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@layerzerolabs/lz-v2-utilities": "3.0.167",
    "circomlibjs": "0.1.7",
    "fixed-merkle-tree": "0.7.3",
    "libsodium-wrappers-sumo": "^0.7.13",
    "snarkjs": "0.7.4",
    "viem": "2.43.5"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {},
  "optionalDependencies": {}
}
